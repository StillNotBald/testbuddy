# Server-side rewrite target for /api/* and /_/* (PocketBase). Not exposed to the browser.
PB_URL=http://127.0.0.1:8090

# Data source for the UI service layer: mock (in-memory fixtures) | pocketbase
NEXT_PUBLIC_DATA_SOURCE=mock

# PocketBase superuser bootstrap (used once by `pocketbase superuser upsert`; set values locally, never commit)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# MCP server (M0 demo). token:role pairs, role = admin | manager | tester | viewer (fictional demo users).
# Defaults apply only outside production; in production set this or every call returns 401.
# Replace with your own throwaway values for any shared deployment. Never reuse a real secret.
MCP_DEMO_TOKENS=tb_demo_admin_local_only:admin,tb_demo_manager_local_only:manager,tb_demo_tester_local_only:tester,tb_demo_viewer_local_only:viewer
# Optional: allowed browser Origins (comma list, or *). Requests without an Origin header always pass.
MCP_ALLOWED_ORIGINS=
# Optional: requests per minute per token (default 120).
MCP_RATE_LIMIT_PER_MIN=120

# Demo data set for the mock source: standard (default) | heavy ("Busy team": thousands of rows, ~3.8 MB in localStorage).
# A choice made in the user menu (Reset demo data) or with /sign-in?demo=heavy wins over this default.
NEXT_PUBLIC_DEMO_SEED=standard
