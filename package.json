{
  "name": "testbuddy-web",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source test management app: test cases, runs, milestones and reports. Milestone 0 is a UI on a mock local database; PocketBase backend in Milestone 1.",
  "keywords": [
    "test-management",
    "test-cases",
    "test-runs",
    "qa",
    "nextjs",
    "pocketbase",
    "open-source"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StillNotBald/testbuddy.git"
  },
  "homepage": "https://github.com/StillNotBald/testbuddy",
  "bugs": {
    "url": "https://github.com/StillNotBald/testbuddy/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "pb:download": "node scripts/pb-download.mjs",
    "pb:start": "bin/pocketbase serve --http=127.0.0.1:8090 --dir=pb_data --hooksDir=pb_hooks --migrationsDir=pb_migrations",
    "pb:typegen": "node -e \"console.log('pb:typegen: available after M1')\"",
    "rtm:verify": "node scripts/rtm-verify.mjs",
    "start:standalone": "node scripts/start-standalone.mjs",
    "render:check": "node scripts/render-check.mjs",
    "user-guide:shots": "node scripts/user-guide-pdf.mjs --shots",
    "user-guide:pdf": "node scripts/user-guide-pdf.mjs",
    "mcp:stdio": "node mcp/server.mjs",
    "mcp:smoke": "node mcp/smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pocketbase": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
